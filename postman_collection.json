    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData?.data?.accessToken) pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "if (jsonData?.data?.refreshToken) pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "if (jsonData?.data?.user?._id) pm.collectionVariables.set('userId', jsonData.data.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"01700000000\",\n  \"password\": \"12345678\",\n  \"confirmPassword\": \"12345678\",\n  \"role\": \"buyer\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "response": []
        },
